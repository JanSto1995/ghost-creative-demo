{
  "name": "ghost-creative-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A synthetic, independently implemented creative workflow demo.",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalize-csp.mjs && node scripts/verify-artifacts.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@electric-sql/pglite": "0.5.8",
    "prettier": "3.9.8"
  },
  "type": "module"
}
